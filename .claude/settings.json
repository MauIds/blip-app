{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" setup >/dev/null; bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" memory-import; bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" run review stop-hook --agent claude-code",
            "timeout": 300,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" run review stop-hook --agent claude-code",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" memory-export",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gentle-ai.sh\" run skill-registry refresh --quiet --no-gitignore --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "outputStyle": "Gentleman"
}
